# The Blockheads recipes — 自定义参考格式 v1
# 语法：
#   [bench_id] 名称  { attr=value ... }
#     L<level>:
#       <产物> x<数量>  <=  <材料> x<数量> [+ <材料> x<数量>]...  @<秒>s
#   time 为 '-' 表示 wiki 未记录。

[workbench] Workbench  { category=core fuel=no electric=no max_level=4 }
  L1:
    Campfire x1                        <=  Stick x10                                                  @-
    Craft Bench x1                     <=  Dirt x1 + Stick x1                                         @-
    Tool Bench x1                      <=  Dirt x1 + Flint x1                                         @-
    Woodwork Bench x1                  <=  Wood x1                                                    @-
  L2:
    Builder's Bench x1                 <=  Stone x1 + Limestone x1 + Marble x1                        @-
    Compost Bin x1                     <=  Wood x1 + Dirt x1 + Worm x5                                @-
    Easel x1                           <=  Wood x1                                                    @-
    Furnace x1                         <=  Stone x1 + Charcoal x10                                    @-
    Kiln x1                            <=  Stone x1 + Clay x3 + Stick x10                             @-
    Portal x1                          <=  Stone x1 + Time Crystal x100                               @-
    Press x1                           <=  Stone x1 + Wood x1                                         @-
    Tailor's Bench x1                  <=  Stone x1 + Flax x5                                         @-
  L3:
    Armor Bench x1                     <=  Stone x1 + Tin Ingot x5                                    @-
    Dye Bench x1                       <=  Stone x1 + Bucket of Water x1 + Linen x1                   @-
    Metalwork Bench x1                 <=  Bronze Ingot x5 + Coal x2                                  @-
    Mixing Bench x1                    <=  Stone x1 + Tin Bucket x1 + Oil x5                          @-
    Shop x1                            <=  Stone x1 + Gold Coin x1                                    @-
    Train Yard x1                      <=  Stone x1 + Steel Ingot x5                                  @-
  L4:
    Electric Furnace x1                <=  Steel Block x1 + Iron Ingot x1 + Copper Wire x10           @-
    Electric Kiln x1                   <=  Steel Block x1 + Red Bricks x1 + Copper Wire x10           @-
    Electric Metalwork Bench x1        <=  Steel Block x1 + Steel Ingot x1 + Copper Wire x10          @-
    Electric Press x1                  <=  Steel Block x1 + Copper Block x1 + Copper Wire x10         @9
    Electric Sluice x1                 <=  Steel Block x1 + Electric Motor x1 + Bucket of Water x1 + Copper Wire x10 @-
    Electric Stove x1                  <=  Steel Block x1 + Iron Pot x1 + Copper Wire x10             @-
    Flywheel x1                        <=  Steel Block x1 + Copper Block x1 + Electric Motor x1 + Copper Wire x10 @-
    Refinery x1                        <=  Electric Furnace x1 + Copper Boiler x1 + Copper Wire x10 + Oil x10 @-
    Solar Panel x1                     <=  Steel Block x1 + Silicon Wafer x3 + Copper Wire x10        @-
    Steam Generator x1                 <=  Steel Block x1 + Steam Engine x1 + Electric Motor x1       @-

[armor_bench] Armor Bench  { category=bench fuel=no electric=no max_level=1 }
  L1:
    Iron Armor Leggings x1             <=  Iron Ingot x3                                              @-
    Tin Armor Leggings x1              <=  Tin Ingot x3                                               @-
    Tin Chest Plate x1                 <=  Tin Ingot x5                                               @-

