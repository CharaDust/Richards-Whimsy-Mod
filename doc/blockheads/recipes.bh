    Soft Bed x1                        <=  Wooden Bed x1 + Linen x3 + Dodo Feather x5                 @4

[tool_bench] Tool Bench  { category=bench fuel=no electric=no max_level=6 }
  L1:
    Bronze Machete x1                  <=  Stick x1 + Bronze Ingot x2                                 @7
    Bronze Pickaxe x1                  <=  Stick x1 + Bronze Ingot x5                                 @7
    Bronze Sword x1                    <=  Stick x1 + Bronze Ingot x3                                 @7
    Flint Axe x1                       <=  Stick x1 + Flint x3                                        @4
    Flint Machete x1                   <=  Stick x1 + Flint x2                                        @4
    Iron Machete x1                    <=  Stick x1 + Iron Ingot x2                                   @-
    Iron Pickaxe x1                    <=  Stick x1 + Iron Ingot x5                                   @4
    Iron Sword x1                      <=  Stick x1 + Iron Ingot x3                                   @4
  L2:
    Copper Bow & Arrows x1             <=  Stick x50 + Copper Ingot x5 + Dodo Feather x5 + String x1  @3
    Stone Axe x1                       <=  Stick x1 + Stone x3                                        @6
  L4:
    Iron Axe x1                        <=  Stick x1 + Iron Ingot x3                                   @8
  L5:
    Crowbar x1                         <=  Steel Ingot x2                                             @8
  L6:
    Gold Bow & Poison Arrows x1        <=  Stick x50 + Gold Ingot x5 + Dodo Feather x5 + Poison x5    @16

