[press] Press  { category=bench fuel=no electric=no max_level=2 }
  L1:
    Black Sand x1                      <=  Sand x1 + Pig Iron x3                                      @8
    Carbon Black x1                    <=  Charcoal x5                                                @4
    Green Coffee Bean x1               <=  Coffee Cherry x1                                           @2
