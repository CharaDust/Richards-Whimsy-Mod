    Black Glass Column x2              <=  Black Glass x1                                             @4
    Black Glass Stairs x2              <=  Black Glass x1                                             @4
    Brick Column x2                    <=  Red Bricks x1                                              @4
    Brick Stairs x2                    <=  Red Bricks x1                                              @4
    Glass Column x2                    <=  Glass x1                                                   @4
    Glass Stairs x2                    <=  Glass x1                                                   @4
    Ice Column x2                      <=  Ice x1                                                     @-
    Ice Stairs x2                      <=  Ice x1                                                     @-
    Lapis Lazuli Column x2             <=  Lapis Lazuli x1                                            @4
    Lapis Lazuli Stairs x2             <=  Lapis Lazuli x1                                            @4
    Limestone Column x2                <=  Limestone x1                                               @-
    Limestone Stairs x2                <=  Limestone x1                                               @-
    Marble Column x2                   <=  Marble x1                                                  @-
    Marble Stairs x2                   <=  Marble x1                                                  @-
    Red Marble Column x2               <=  Red Marble x1                                              @4
    Red Marble Stairs x2               <=  Red Marble x1                                              @4
    Sandstone Column x2                <=  Sandstone x1                                               @4
    Sandstone Stairs x2                <=  Sandstone x1                                               @4
    Stone Column x2                    <=  Stone x1                                                   @4
    Stone Stairs x2                    <=  Stone x1                                                   @4
    Wood Column x2                     <=  Wood x1                                                    @4
    Wood Stairs x2                     <=  Wood x1                                                    @4
  L2:
    Bronze Column x2                   <=  Bronze Block x1                                            @4
    Bronze Stairs x2                   <=  Bronze Block x1                                            @4
    Carbon Fiber Column x1             <=  Carbon Fiber Sheet x1                                      @4
    Carbon Fiber Stairs x1             <=  Carbon Fiber Sheet x1                                      @4
    Copper Column x2                   <=  Copper Block x1                                            @4
    Copper Stairs x2                   <=  Copper Block x1                                            @4
    Gold Column x2                     <=  Gold Block x1                                              @4
    Gold Stairs x2                     <=  Gold Block x1                                              @4
    Iron Column x2                     <=  Iron Block x1                                              @4
    Iron Stairs x2                     <=  Iron Block x1                                              @4
    Platinum Column x2                 <=  Platinum Block x1                                          @4
    Platinum Stairs x2                 <=  Platinum Block x1                                          @4
    Steel Column x2                    <=  Steel Block x1                                             @4
    Steel Stairs x2                    <=  Steel Block x1                                             @4
    Tin Column x2                      <=  Tin Block x1                                               @4
    Tin Stairs x2                      <=  Tin Block x1                                               @4
    Titanium Column x2                 <=  Titanium Block x1                                          @4
    Titanium Stairs x2                 <=  Titanium Block x1                                          @4

